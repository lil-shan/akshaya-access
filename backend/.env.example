# Backend settings (placeholders only; the backend needs no API keys: KSEB and UPI 123PAY are SIMULATED).
# SQLite file used by the API. Default: backend/data.db
BACKEND_DB_PATH=./data.db
# Port used by ./smoke.sh for its own throwaway server (default 8765, so a dev server on :8000 is untouched).
PORT=8765
# Bearer token required on every request to the public phone port (uvicorn public_app:app --port 8001),
# sent as `Authorization: Bearer <PHONE_TOOLS_TOKEN>`. Port 8001 refuses to start without it. Required.
PHONE_TOOLS_TOKEN=
