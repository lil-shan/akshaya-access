# Copy to .integrations.env (git-ignored) and fill in TEST/SANDBOX values only. Never commit the real file.
# Razorpay test mode — Dashboard → (Test Mode on) → Account & Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Eko EPS (UAT) — eps.eko.in → sign up with mobile OTP → Developer / UAT credentials
EKO_DEVELOPER_KEY=
EKO_ACCESS_KEY=
EKO_INITIATOR_ID=
EKO_USER_CODE=
# DigiLocker sandbox — API Setu partner sandbox (or IDfy SelfServe trial)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=
